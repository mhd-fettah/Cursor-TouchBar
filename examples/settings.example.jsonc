// Cursor Touch Bar example configuration
//
// Copy what you need into user settings
// (Cmd+Shift+P → "Preferences: Open User Settings (JSON)").
// The gear button on the Touch Bar edits the same settings.
// A slot you leave out keeps its default.

{
  "cursorTouchBar.buttons": {
    // Left sidebar
    "slot1": {
      "enabled": true,
      "icon": "panel-left",
      "type": "command",
      "command": "workbench.action.toggleSidebarVisibility"
    },

    // Bottom panel
    "slot2": {
      "enabled": true,
      "icon": "panel-bottom",
      "type": "command",
      "command": "workbench.action.togglePanel"
    },

    // Right sidebar. Use workbench.action.toggleUnifiedSidebar instead
    // if that is where your chat sits.
    "slot3": {
      "enabled": true,
      "icon": "panel-right",
      "type": "command",
      "command": "workbench.action.toggleAuxiliaryBar"
    },

    // New chat
    "slot4": {
      "enabled": true,
      "icon": "message-square-plus",
      "type": "command",
      "command": "aichat.newchataction"
    },

    // Opens Ask, Plan, and Agent on the bar
    "slot5": {
      "enabled": true,
      "icon": "layers",
      "type": "page",
      "page": "modes"
    },

    // Opens your skills
    "slot6": {
      "enabled": true,
      "icon": "folder",
      "type": "page",
      "page": "skills"
    }
  },

  // A tap opens a new chat with this text filled in. Press Enter to send.
  // Skills that share a group open together. The bar shows the icon.
  "cursorTouchBar.skills": [
    {
      "id": "review",
      "label": "Review",
      "prompt": "Review the current changes and list the risks.",
      "icon": "search",
      "group": "Git"
    },
    {
      "id": "commit",
      "label": "Commit",
      "prompt": "Write a commit message for the current changes.",
      "icon": "circle-check",
      "group": "Git"
    }
  ]
}
