// Cursor TouchBar example configuration
//
// Copy what you need into user settings
// (Cmd+Shift+P → "Preferences: Open User Settings (JSON)").
// The gear button on the Touch Bar edits the same settings.
// A slot you leave out keeps its default.
// slot8–slot10 are off until you add them.
// "spaceBefore": true leaves a gap before that button. Leave it out to group it with the button on the left.

{
  "cursorTouchBar.showNextStackLogo": true,

  "cursorTouchBar.buttons": {
    "slot1": {
      "enabled": true,
      "icon": "panel-left",
      "type": "command",
      "command": "workbench.action.toggleSidebarVisibility"
    },
    "slot2": {
      "enabled": true,
      "icon": "panel-bottom",
      "type": "command",
      "command": "workbench.action.togglePanel"
    },
    "slot3": {
      "enabled": true,
      "icon": "panel-right",
      "type": "command",
      "command": "workbench.action.toggleAuxiliaryBar"
    },
    "slot4": {
      "enabled": true,
      "icon": "message-square-plus",
      "type": "command",
      "command": "composer.createNew",
      "spaceBefore": true
    },
    "slot5": {
      "enabled": true,
      "icon": "mic",
      "type": "command",
      "command": "composer.toggleVoiceDictation"
    },
    "slot6": {
      "enabled": true,
      "icon": "layers",
      "type": "page",
      "page": "modes",
      "spaceBefore": true
    },
    "slot7": {
      "enabled": true,
      "icon": "folder",
      "type": "page",
      "page": "skills",
      "spaceBefore": true
    }
  },

  "cursorTouchBar.skillGroups": ["Review", "Workflow", "Customize", "Build"],

  // Preset shortcuts to Cursor built-in /skills (see skill-presets.js).
  "cursorTouchBar.skills": [
    { "id": "review", "label": "review", "group": "Review", "prompt": "/review" },
    { "id": "review-bugbot", "label": "review-bugbot", "group": "Review", "prompt": "/review-bugbot" },
    { "id": "automate", "label": "automate", "group": "Workflow", "prompt": "/automate" },
    { "id": "create-skill", "label": "create-skill", "group": "Customize", "prompt": "/create-skill" }
  ]
}
